# Every setting the app reads, with its default. Copy to `.env` and edit, or set
# these in the service manager / shell that launches the app.
#
# NOTE: the app does NOT auto-load a `.env` file -- there is no python-dotenv
# dependency. Either export these in the shell, put them in your systemd unit /
# Windows service, or source the file before launching:
#
#   Linux/macOS:  set -a; . ./.env; set +a; python app.py
#   PowerShell:   Get-Content .env | ForEach-Object {
#                   if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                     [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim())
#                   } }; python app.py
#
# An unparseable value is ignored with a warning on stderr and the default is
# used -- a typo here degrades the setting, it does not stop the app booting.
#
# The defaults these override live in `settings.py`, one per line with a comment
# saying what was measured to arrive at it. Prompts are in `prompts.py`.

# --------------------------------------------------------------------------
# network
# --------------------------------------------------------------------------

# Interface to bind. 127.0.0.1 (default) accepts local connections only.
# Set 0.0.0.0 to accept from other hosts -- but the app has NO authentication and
# NO rate limiting, so only do that behind a reverse proxy or on a trusted
# network. Startup prints a warning whenever this is not loopback.
#
# Plain HOST is also accepted as a fallback, for platforms that set it for you;
# OCR_HOST wins when both are present. Prefer OCR_HOST -- HOST is a common name
# and something else on the box may already own it.
OCR_HOST=127.0.0.1
PORT=5000

# --------------------------------------------------------------------------
# model server
# --------------------------------------------------------------------------

# The default endpoint, and the first one offered in the page's picker.
LLAMA_URL=http://127.0.0.1:8080

# Comma-separated. Overrides the offered list entirely; when unset the list is
# LLAMA_URL plus Ollama's default http://127.0.0.1:11434.
# OCR_ENDPOINTS=http://127.0.0.1:8080,http://gpu-box:11434

# Context window asked for on every request (clamped to 4096..32768). Ollama's
# own default of 4096 is too small for a full page plus instructions.
OLLAMA_NUM_CTX=8192

# (connect, read) seconds for a generation request. The read timeout is the one
# that matters: raise it on slow CPU-only hardware, where a dense page at
# `original` detail legitimately takes many minutes.
GEN_CONNECT_TIMEOUT=10
GEN_READ_TIMEOUT=1800

# --------------------------------------------------------------------------
# paths -- all optional, all default to directories beside app.py
# --------------------------------------------------------------------------

# Source documents offered in the page's folder picker. Absent = upload only.
# OCR_MOCK_DIR=./mockOcr

# Ground-truth transcripts for accuracy scoring. Absent = scoring switches off
# and the page hides the benchmark controls.
# OCR_SOLUTION_DIR=./solution

# The only directory the app writes to. Point it outside the application
# directory to mount that read-only.
# OCR_LOG_DIR=./logs

# --------------------------------------------------------------------------
# intake limits -- per-request cost paid by the model server
# --------------------------------------------------------------------------

MAX_UPLOAD_MB=32
MAX_PAGES=10
PDF_DPI=300
MAX_NEW_TOKENS=4096

# Rendered page images kept in memory for the compare view. A RAM ceiling as much
# as a history depth: a 10-page document at `medium` is roughly 40 MB.
MAX_JOBS=5

# Queue worker threads. Unset = one per model-server slot, which is the right
# default; more workers than slots just hides the wait inside the model server.
# OCR_WORKERS=1

# --------------------------------------------------------------------------
# pipeline behaviour -- each default was measured, not picked. Change one at a
# time and re-run `python compare.py`: the failure mode here is a silent accuracy
# drop at HTTP 200, not an error.
# --------------------------------------------------------------------------

# Second pass: extract structured fields from the finished transcript.
EXTRACT=1
EXTRACT_MAX_TOKENS=4096

# Constrain the reply to the field schema rather than to "any valid JSON". The
# key names go into the decoder's grammar, so an OCR model cannot answer pass 2
# with a transcript in its own envelope. Set to 0 for the older behaviour.
EXTRACT_SCHEMA=1

# Repetition penalty for Ollama, and the only place this project sets one above
# 1.0. Ollama's OpenAI-compatible endpoint drops the DRY sampler below, so pass 2
# ran there with nothing suppressing a loop. Set to 1.0 to turn it off: it costs
# the odd repeated character in a figure, which is what DRY exists to avoid.
OLLAMA_REPEAT_PENALTY=1.1

# Which shape the second pass starts in. 0 asks for the whole form in one
# request; 1 walks the field groups, asking for one to three fields per request
# against the same transcript -- slower, and much harder for a value to land in a
# field it does not belong to. The page's Agentic button switches it at runtime,
# so this only sets what a fresh process starts with.
AGENTIC_EXTRACT=0
# How many times an agentic step may be asked again after returning a value that
# is not in the transcript. 0 turns the retry off.
AGENTIC_RETRIES=1
# The lowest transcript accuracy that still gets its extraction SCORED, where
# both passes ran on a document with known ground truth. Below it the fields are
# still extracted and still logged, but the field score is left off the row: pass
# 2 can only map what pass 1 produced, so a score over a broken transcript
# measures the read and blames the extractor. A read below this is NOT counted as
# a failed run -- a failure is a loop or a crash. 0 scores everything.
MIN_READ_FOR_FIELDS=0.75

# How many of the most recent runs OF EACH setting, model and document the
# summaries, ranking tables and standouts are computed over -- per row, not the
# last N lines of the file. The CSV keeps everything; this bounds only what gets
# averaged, because a mean taken across a change to the scorer, the schema or the
# presets describes a build nobody is running. 0 = the whole log.
SUMMARY_RUNS=50

# How a read is marked GPU or CPU, and cold or warm, on the analysis tab. Neither
# is recorded -- the app talks HTTP to a server it did not launch -- so both are
# INFERRED from figures the run already has, and both are proxies rather than
# probes. A read decoding at or above GPU_MIN_TPS tokens/second reads as GPU
# (a CPU-only server on a 2-4B vision model is single digits); one whose prefill
# is under WARM_PREFILL_MAX seconds reads as warm, i.e. a cached prefix or an
# already-resident model. A read missing the figure is marked neither.
GPU_MIN_TPS=15.0
WARM_PREFILL_MAX=1.0

# The outlier fence on the analysis tab. A read is left out of every figure
# there only when it fails BOTH tests against its own cell -- the other reads at
# the same model, document AND Detail. The Detail is part of the cell because
# raising it legitimately costs x1.5 to x2.6 of the clock, so judging an
# `original` read against a median made of `low` ones would drop it for being
# exactly what it should be.
#
#   MADS      -- how many median-absolute-deviations from the cell median. MAD
#                rather than a standard deviation because an SD is dragged by
#                the outlier it is measuring. 0 disables the fence entirely.
#   MIN_RATIO -- and how many times the median, two-sided. This is what stops a
#                tightly clustered cell (MAD of a fraction of a second) flagging
#                ordinary wall-clock jitter: a few seconds is noise, not a
#                finding. The real runaways here are 8x to 16x their median.
#   MIN_RUNS  -- cells smaller than this are not tested. A two-read cell cannot
#                be tested in principle: the median sits between the pair, so
#                neither is far from it however different they are. Untested
#                reads are KEPT and their count is reported on the tab.
#
# The excluded runs stay in the log, the raw table and the CSV, and the tab
# lists them with the evidence against each.
ANALYSIS_OUTLIER_MADS=3.5
ANALYSIS_OUTLIER_MIN_RATIO=2.0
ANALYSIS_OUTLIER_MIN_RUNS=3

# The Summary tab's bias. That tab is the one view on the run-log card meant to
# be shown rather than argued from, so it is allowed to leave models out -- by
# these rules, never by a list of model names, and everything it drops is named
# on the page with a checkbox that puts it all back.
#
# A model is judged on the same figures the tab prints: accuracy x (1 - failure
# rate), i.e. what one attempt is worth.
#
#   MIN_SHARE   -- the least it may deliver as a fraction of what the BEST model
#                  in that pass delivers. Relative rather than absolute because
#                  no single cut is right for both passes: a middling reader is
#                  a poor product beside the best one, while a middling
#                  extractor is a real contender here. 0 disables this test.
#   MAX_FAILURE -- and the most of its runs it may fail, as a percentage. This
#                  one IS absolute: reliability is not graded on a curve.
#   MIN_RUNS    -- a model with fewer runs than this is never dropped. Thin
#                  evidence is not a verdict, and a newly pulled model should
#                  not vanish before it has been measured.
PRESENT_MIN_SHARE=0.6
PRESENT_MAX_FAILURE=40
PRESENT_MIN_RUNS=3

# Crop uniform blank scan borders before applying the resolution cap.
TRIM_MARGINS=1

# Send the instruction before the image so llama.cpp can cache it across
# requests. llama.cpp only -- the same ordering destroys the read on Ollama.
PROMPT_FIRST=1
PROMPT_FIRST_OLLAMA=0

# The system message sent with every Ollama request. Ollama only: llama-server is
# sent none, and its baselines were measured that way.
#
# This default is not a new instruction -- it is the text Ollama was already
# injecting from the served model's Modelfile, now sent explicitly so a Modelfile
# change cannot move accuracy silently. Set it empty to send no system message at
# all, which is the shape for comparing the two backends bare and is measurably
# worse for ordinary use.
OLLAMA_SYSTEM=You are a helpful assistant.

# Ollama only. A reasoning model returns its chain of thought separately and
# leaves the answer empty until it stops thinking, so every capped request this
# app makes comes back empty -- qwen3.5:4b failed all seven agentic steps on all
# five fixtures that way. "none" turns thinking off, and is a byte-for-byte
# no-op on a model that does not think. Set low/medium/high to allow thinking,
# and raise EXTRACT_MAX_TOKENS with it. Empty does not send the field at all.
OLLAMA_REASONING_EFFORT=none

# Stop the models Ollama is holding when the picker switches to another one, so
# the new model loads onto a free card instead of beside the old one. Sends what
# `ollama stop <model>` sends. Ollama only -- llama-server holds one model for
# the life of its process and has nothing to release. Never runs while the queue
# has a job going. Set to 0 on a shared Ollama: it stops every model resident at
# the endpoint, including ones this app did not load.
OLLAMA_UNLOAD_ON_SWITCH=1

# Which pass-1 shape to start in: typhoon | dots. Sets the OCR prompt AND whether
# the system message above is sent, because on some models those two cannot be
# chosen independently -- dots.ocr returns an empty transcript at HTTP 200 if
# either is wrong. Switchable from the page (Page reading) and with
# `compare.py --profile`. typhoon is the default and every accuracy baseline was
# measured on it.
OCR_PROFILE=typhoon

# DRY repetition sampler. llama.cpp applies it; Ollama's OpenAI-compatible
# endpoint silently drops it. Set to 0 on BOTH sides when comparing backends,
# otherwise llama.cpp is being flattered on exactly the documents where a small
# model loops.
DRY_MULTIPLIER=0.8
DRY_ALLOWED_LENGTH=32

# The read backstop: a page whose output starts cycling is cut off where it
# starts repeating, so a runaway costs seconds instead of the whole token budget.
# Set to 0 to let a cycling read run to MAX_NEW_TOKENS -- useful when the backstop
# is cutting short a read you want to see in full. It turns off the ABORT only:
# the transcript is still tested when it arrives and still flagged `looped`, so
# such a run still counts as a failure and stays out of every mean. Switchable
# from the page (Stop a read that starts repeating). Lowering Detail is the usual
# fix for a page that loops.
LOOP_GUARD=1

# How much of a blank/structural tail counts as a runaway rather than a real
# blank grid. ~29 characters per empty table row, so the default tolerates about
# 100 blank rows. Raise it if a real form's blank grid is larger.
LOOP_DEAD_TAIL_CHARS=3000

# --------------------------------------------------------------------------
# tooling
# --------------------------------------------------------------------------

# Which running app compare.py scores against.
# OCR_APP_URL=http://127.0.0.1:5000
